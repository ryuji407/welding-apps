// アーク溶接ロボット 段取りマニュアル DB schema
// 注: SQLiteを使用しているため、配列はJSON文字列として保存する
// 将来Postgresへ移行する際は provider を "postgresql" に変更し、
// String型のJSON配列フィールドを String[] に置換することで対応可能

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Manual {
  id                  String   @id @default(cuid())
  processCode         String   @unique
  productName         String?
  toollessToolCounts  String   @default("{}")  // JSON: { [toolId]: number }
  robotEnvironments   String   @default("[]")  // JSON: ["左","中","右"]
  notes               String?
  toollessToolColor   String?
  workVideoUrl        String?
  layoutPhotoUrl      String?
  wagonPhotoUrl       String?
  notesPhotoUrl       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?

  environmentBlocks   EnvironmentBlock[]
  jigProcessSteps     JigProcessStep[]
  mediaFiles          MediaFile[]
  aliases             ProcessCodeAlias[]
}

model ProcessCodeAlias {
  id          String @id @default(cuid())
  processCode String @unique
  manualId    String
  manual      Manual @relation(fields: [manualId], references: [id], onDelete: Cascade)

  @@index([manualId])
}

model EnvironmentBlock {
  id          String   @id @default(cuid())
  manualId    String
  environment String                                // "左" | "中" | "右"
  stepPhotos  String   @default("{}")              // JSON: {stepNumber: url}
  manual      Manual   @relation(fields: [manualId], references: [id], onDelete: Cascade)
  programs    Program[]

  @@index([manualId])
}

model Program {
  id            String  @id @default(cuid())
  envBlockId    String
  programNumber Int
  stepNumber    Int     @default(1)
  robots        String  @default("[]")              // JSON: ["1号機","2号機"]
  number        String?
  name          String?
  photoUrl      String?
  envBlock      EnvironmentBlock @relation(fields: [envBlockId], references: [id], onDelete: Cascade)

  @@index([envBlockId])
}

model JigProcessStep {
  id         String   @id @default(cuid())
  manualId   String
  stepNumber Int
  manual     Manual   @relation(fields: [manualId], references: [id], onDelete: Cascade)
  images     MediaFile[]

  @@index([manualId])
}

// 全画像・動画ファイルを1テーブルで管理し、kindで用途を区別
model MediaFile {
  id         String   @id @default(cuid())
  url        String                                  // 保存先URL or 相対パス
  filename   String
  mimeType   String
  kind       String                                  // "layout" | "wagon" | "jig" | "video"
  manualId   String?
  jigStepId  String?
  createdAt  DateTime @default(now())

  manual     Manual?         @relation(fields: [manualId], references: [id], onDelete: Cascade)
  jigStep    JigProcessStep? @relation(fields: [jigStepId], references: [id], onDelete: Cascade)

  @@index([manualId])
  @@index([jigStepId])
}

// ─────────────────────────────────────────────────────────
// 製品情報（tube-manual から移植。旧 Firebase Firestore を SQLite に移行）
// ネスト配列は Manual 群と同様に JSON 文字列カラムで保持する。
// id は Firestore の自動ID（既存文字列ID）をそのまま保持する。
// ─────────────────────────────────────────────────────────

model Product {
  id                       String   @id                       // Firestore由来の文字列ID
  name                     String                             // 製品名（旧: 工程名称）
  processCodes             String   @default("[]")            // JSON: string[]（工程コード。工程表からのリンクキー）
  processingNotes          String   @default("")
  photoUrls                String   @default("[]")            // JSON: string[]
  specifications           String   @default("[]")            // JSON: {label,value,photoUrl?}[]
  appliedTemplateInstances String   @default("[]")            // JSON: {instanceId,templateId}[]
  templateValues           String   @default("[]")            // JSON: TemplateFieldValue[]
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model ProductTemplate {
  id        String   @id                                       // Firestore由来の文字列ID
  name      String
  fields    String   @default("[]")                            // JSON: TemplateField[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductDefect {
  id          String   @id                                     // Firestore由来の文字列ID
  productId   String
  productName String
  occurredAt  DateTime
  reportedBy  String   @default("")
  description String   @default("")
  photoUrls   String   @default("[]")                          // JSON: string[]
  createdAt   DateTime @default(now())

  @@index([productId])
}

model ProductNote {
  id                    String   @id                           // = encodeURIComponent(componentOfficialName)
  componentOfficialName String   @unique
  warnings              String   @default("[]")                // JSON: {level,text}[]
  instructionSteps      String   @default("[]")                // JSON: InstructionStep[]
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
